# Copy to .env; keep passwords and tokens out of source control.
REPORT_TIMEZONE=Europe/Rome
REPORT_INTERVAL_MINUTES=60
REPORT_START_TIME=05:30
REPORT_END_TIME=23:59
REPORT_OUTPUT_DIR=output

# Hydro CSV source. Local paths mirror dati/... under DATA_DIR.
DATA_SOURCE=local
DATA_DIR=data
FTP_HOST=
FTP_PORT=21
FTP_REMOTE_ROOT=
FTP_USERNAME=
FTP_PASSWORD=
FTP_TIMEOUT=30

# Higeco API accounts for L'Occhio PV and HSI plants.
HIGECO_BASE_URL=https://higeco-monitoraggio.it/api/v1
HIGECO_USERNAME=
HIGECO_PASSWORD=
HSI_BASE_URL=https://hsi.higeco.com/api/v1
HSI_USERNAME=
HSI_PASSWORD=
API_TIMEOUT=30

# ANSIA mail delivery; disabled unless explicitly enabled.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SUBJECT=Report giornaliero impianti
